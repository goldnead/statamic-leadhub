{
    "name": "goldnead/statamic-leadhub",
    "description": "Turn Statamic form submissions into contacts, timelines, and follow-ups directly inside your Control Panel.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "leads",
        "crm",
        "forms",
        "contacts"
    ],
    "authors": [
        {
            "name": "goldnead",
            "email": "hello@example.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-leadhub/issues",
        "source": "https://github.com/goldnead/statamic-leadhub"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "statamic/cms": "^5.0|^6.0",
        "symfony/yaml": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\Leadhub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\Leadhub\\Tests\\": "tests/",
            "Goldnead\\Leadhub\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "statamic": {
            "name": "LeadHub",
            "description": "Turn Statamic form submissions into contacts, timelines, and follow-ups directly inside your Control Panel."
        },
        "laravel": {
            "providers": [
                "Goldnead\\Leadhub\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true,
            "composer/installers": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
