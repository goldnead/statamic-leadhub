{
    "name": "goldnead/statamic-leadhub",
    "description": "Turn Statamic form submissions into contacts, timelines, and follow-ups directly inside your Control Panel.",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": [
        "statamic",
        "statamic-addon",
        "leads",
        "crm",
        "forms",
        "contacts"
    ],
    "authors": [
        {
            "name": "Adrian Goldner",
            "email": "info@adriangoldner.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-leadhub/issues",
        "source": "https://github.com/goldnead/statamic-leadhub"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "statamic/cms": "^6.0",
        "inertiajs/inertia-laravel": "^1.0|^2.0",
        "symfony/yaml": "^6.0|^7.0|^8.0",
        "goldnead/statamic-brand-context": "^1.8"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "suggest": {
        "goldnead/statamic-webhook-manager": "Fire outbound webhooks on LeadHub events and upsert leads from inbound webhooks",
        "goldnead/statamic-automations": "Build multi-step follow-up workflows triggered by LeadHub events"
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\Leadhub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\Leadhub\\Tests\\": "tests/",
            "Goldnead\\Leadhub\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "statamic": {
            "slug": "leadhub",
            "name": "LeadHub",
            "description": "Turn Statamic form submissions into contacts, timelines, and follow-ups directly inside your Control Panel.",
            "url": "https://github.com/goldnead/statamic-leadhub",
            "developer": "Adrian Goldner",
            "developer-url": "https://gldnr.studio",
            "vite": {
                "input": [
                    "resources/js/cp.js",
                    "resources/css/cp.css"
                ],
                "publicDirectory": "resources/dist"
            }
        },
        "laravel": {
            "providers": [
                "Goldnead\\Leadhub\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "fix": [
            "@php vendor/bin/pint"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true,
            "composer/installers": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
