includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - src
        - config
        - routes
        - database

    # A ratchet, not a rewrite. The baseline freezes what 16.7k lines of src/
    # already carry; everything written from here on has to clear level 5 on
    # its own. Shrink the baseline when you touch a file, do not grow it.
    treatPhpDocTypesAsCertain: false

    # Both classes implement an interface from an OPTIONAL sibling addon
    # (`suggest`, not `require`). The addon is built to work with the sibling
    # absent — the whole bridge is a no-op then, and the default test suite runs
    # in exactly that state to prove it. PHPStan cannot analyse a class whose
    # parent interface is not installed, and `interface.notFound` is
    # non-ignorable, so the two files are excluded rather than the dependency
    # being made hard.
    excludePaths:
        analyseAndScan:
            - src/Integrations/Notifications/TaskDigestSource.php
            - src/Integrations/WebhookManager/LeadhubTrigger.php

    # The analytics bridge takes the other road, and the difference is worth a
    # line. Its sibling is a `suggest` too, but this addon keeps a stand-in for
    # that contract in tests/Fakes — so the classes can be ANALYSED rather than
    # skipped. `InsightsContractsMatchTest` holds the stand-in against the real
    # package wherever the real package can be found, which is what stops the
    # analysis from being a check against a fiction.
    scanFiles:
        - tests/Fakes/insights-contracts.php
        - tests/Fakes/insights-table-metric.php

    # And the notifications bridge takes a third road, which is the cheapest of
    # the three wherever it is available: `Goldnead\IdentityContracts\Identity`
    # comes from `goldnead/statamic-identity-contracts`, a public,
    # dependency-free contracts package, so it sits in `require-dev` and the
    # analysis reads the REAL class — no exclusion, no stand-in to keep in sync,
    # no ignore rule to go stale. It stays out of `require` because the runtime
    # need is genuinely optional: the type is only ever touched inside the
    # closure the bridge hands to `goldnead/statamic-notifications`, which is a
    # `suggest`, and that package requires identity-contracts itself. So on
    # every install where the line can run, the class is really there.
